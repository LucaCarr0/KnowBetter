# Optional: use a managed PostgreSQL instead of local embedded PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/knowbetter

# One coordinator process owns all active rooms and socket connections.
PORT=3000
LOBBY_DATA_DIR=.data/knowbetter
GUEST_TTL_MS=86400000
ROOM_RESERVATION_MS=90000
ROOM_IDLE_MS=3600000

# Set the HTTPS origin for production, for example https://quiz.example.com.
# APP_ORIGIN=https://quiz.example.com
