{
  "name": "know-better",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none src/features/game/hooks/*.test.ts src/server/*.test.ts src/server/game/*.test.ts src/server/content/*.test.ts scripts/*.test.ts",
    "test:unit": "node --import tsx --test --test-isolation=none src/server/lobby.test.ts src/server/shutdown.test.ts src/server/shutdown-database.test.ts src/server/game-integration.test.ts src/server/bonus-integration.test.ts src/server/trivia.test.ts src/server/database.test.ts src/server/database-lock.test.ts scripts/db.test.ts src/server/game/*.test.ts src/server/content/*.test.ts",
    "trivia:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-trivia.ts",
    "db:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts inspect",
    "db:sql": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts sql",
    "db:console": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts console"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@electric-sql/pglite": "^0.5.11",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.50",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
